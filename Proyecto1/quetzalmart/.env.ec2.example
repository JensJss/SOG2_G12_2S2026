# =============================================================================
#  .env para la EC2 (Ubuntu 24.04)  ->  cp .env.ec2.example .env  &&  nano .env
#  CAMBIA TODAS LAS CONTRASEÑAS (solo letras, números, guion y guion bajo).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAR_db_password
PG_BIND=127.0.0.1        # BD no expuesta a internet; consultas por SSH/túnel
PG_PORT=5432             #   (si quieren DBeaver directo: PG_BIND=0.0.0.0 y abrir 5432 SOLO a sus IPs)

# --- Odoo ---
ODOO_DB=quetzalmart
ODOO_BIND=127.0.0.1      # Odoo solo detrás de nginx (puerto 80)
ODOO_PORT=8069
ODOO_MASTER_PASSWORD=CAMBIAR_master_password
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=CAMBIAR_admin_password
ODOO_PUBLIC_URL=http://IP_PUBLICA_O_DOMINIO
ODOO_LIST_DB=True        # pasar a False después de crear la base y reiniciar odoo
ODOO_PROXY_MODE=True     # obligatorio detrás de nginx

# --- nginx (perfil proxy) ---
HTTP_PORT=80

# --- Opcionales ---
MAILPIT_UI_PORT=8025
ADMINER_BIND=127.0.0.1   # se usa con túnel SSH:  ssh -L 18081:localhost:18081 ...
ADMINER_PORT=18081

HOST_UID=1000            # usuario ubuntu
HOST_GID=1000
