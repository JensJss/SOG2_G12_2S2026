# =============================================================================
#  .env para PC LOCAL (Windows/Linux con Docker Desktop)
#  Copiar:  copy .env.example .env      (Windows)   |   cp .env.example .env
#  Contraseñas: usa solo letras, números, guion y guion bajo (sin comillas ni $).
# =============================================================================

# --- PostgreSQL (contenedor quetzalmart-db) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=QM_db_2026_local
PG_BIND=127.0.0.1
PG_PORT=15432            # 5432 ya está ocupado en la PC (postgres_db)

# --- Odoo (contenedor quetzalmart-odoo) ---
ODOO_DB=quetzalmart
ODOO_BIND=0.0.0.0
ODOO_PORT=18069          # 8069/8072 ya están ocupados (rutamoto-odoo)
ODOO_MASTER_PASSWORD=QM_master_2026_local
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=QM_admin_2026
ODOO_PUBLIC_URL=http://localhost:18069
ODOO_LIST_DB=True        # pasar a False después de crear la base
ODOO_PROXY_MODE=False

# --- Perfiles opcionales ---
HTTP_PORT=18088          # nginx (solo si usas --profile proxy en local)
MAILPIT_UI_PORT=18025    # 8025/1025 ya están ocupados (rutamoto-mail)
ADMINER_BIND=127.0.0.1
ADMINER_PORT=18081

# --- Dueño de los PDFs exportados (Linux). En Windows no importa. ---
HOST_UID=1000
HOST_GID=1000
